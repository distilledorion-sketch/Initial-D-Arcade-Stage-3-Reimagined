  "scripts": [
    [
      {
        "speaker": 0,
        "lines": [
          "HEY, COLE.",
          "",
          ""
        ],
        "address": "0C2FBBA4"
      },
      {
        "speaker": 0,
        "lines": [
          "I'VE HEARD THAT I CAN CUSTOMIZE MY CAR",
          "IF I HAVE AN INITIAL D CARD.",
          ""
        ],
        "address": "0C2FBBB4"
      },
      {
        "speaker": 1,
        "lines": [
          "THAT'S RIGHT.",
          "",
          ""
        ],
        "address": "0C2FBBC4"
      },
      {
        "speaker": 1,
        "lines": [
          "RACING AGAINST RIVALS",
          "EARNS YOU POINTS, RIGHT?",
          ""
        ],
        "address": "0C2FBBD4"
      },
      {
        "speaker": 1,
        "lines": [
          "IF YOU COLLECT ENOUGH POINTS,",
          "YOU CAN CUSTOMIZE YOUR CAR.",
          ""
        ],
        "address": "0C2FBBE4"
      },
      {
        "speaker": 2,
        "lines": [
          "COOL!",
          "",
          ""
        ],
        "address": "0C2FBBF4"
      },
      {
        "speaker": 1,
        "lines": [
          "YOU CAN CHOOSE CUSTOM",
          "PARTS FROM 41 DIFFERENT",
          "MANUFACTURERS."
        ],
        "address": "0C2FBC04"
      },
      {
        "speaker": 0,
        "lines": [
          "WHEW! I CAN'T MAKE UP MY MIND",
          "WITH SO MANY CHOICES!",
          ""
        ],
        "address": "0C2FBC14"
      },
      {
        "speaker": 2,
        "lines": [
          "BUT WHICH ONES SHOULD I PICK?",
          "",
          ""
        ],
        "address": "0C2FBC24"
      },
      {
        "speaker": 2,
        "lines": [
          "I DON'T KNOW MUCH ABOUT",
          "CUSTOMIZING, YOU KNOW.",
          ""
        ],
        "address": "0C2FBC34"
      },
      {
        "speaker": 1,
        "lines": [
          "YOU CAN SELECT A,",
          "CUSTOMIZATION OPTION",
          "WHEN YOU BUY A CARD."
        ],
        "address": "0C2FBC44"
      },
      {
        "speaker": 1,
        "lines": [
          "THAT WAY YOUR CAR WILL GET",
          "CUSTOMIZED AUTOMATICALLY",
          "AS YOU SAVE UP POINTS."
        ],
        "address": "0C2FBC54"
      },
      {
        "speaker": 1,
        "lines": [
          "IT'LL BE NO PROBLEM EVEN IF YOU",
          "DON'T KNOW MUCH ABOUT MECHA-",
          "NICAL STUFF AS WELL AS TAK."
        ],
        "address": "0C2FBC64"
      },
      {
        "speaker": 1,
        "lines": [
          "YOU CAN ALSO SAVE YOUR",
          "GAME STATUS AND TIMES.",
          ""
        ],
        "address": "0C2FBC74"
      },
      {
        "speaker": 1,
        "lines": [
          "AND CONTINUE YOUR GAME",
          "WHENEVER YOU WANT.",
          ""
        ],
        "address": "0C2FBC84"
      },
      {
        "speaker": 1,
        "lines": [
          "TAK, YOU SHOULD",
          "DEFINITELY GET ONE.",
          ""
        ],
        "address": "0C2FBC94"
      },
      {
        "speaker": 2,
        "lines": [
          "OKAY!",
          "",
          ""
        ],
        "address": "0C2FBCA4"
      }
    ],
    [
      {
        "speaker": 0,
        "lines": [
          "HEY, COLE.",
          "",
          ""
        ],
        "address": "0C2FBCB4"
      },
      {
        "speaker": 0,
        "lines": [
          "I'VE HEARD 'BATTLE RACE'",
          "IS AVAILABLE IN THIS GAME.",
          ""
        ],
        "address": "0C2FBCC4"
      },
      {
        "speaker": 2,
        "lines": [
          "WHAT IS THAT?",
          "",
          ""
        ],
        "address": "0C2FBCD4"
      },
      {
        "speaker": 1,
        "lines": [
          "BATTLE RACE, HUH?",
          "",
          ""
        ],
        "address": "0C2FBCE4"
      },
      {
        "speaker": 1,
        "lines": [
          "WELL, LET'S SAY",
          "SOMEONE'S PLAYING",
          "THE GAME ALONE"
        ],
        "address": "0C2FBCF4"
      },
      {
        "speaker": 2,
        "lines": [
          "YEAH.",
          "",
          ""
        ],
        "address": "0C2FBD04"
      },
      {
        "speaker": 1,
        "lines": [
          "AND HE HAS THE AWESOME",
          "TECHNIQUE, DON'T YOU WANNA",
          "BATTLE AGAINST HIM?"
        ],
        "address": "0C2FBD14"
      },
      {
        "speaker": 0,
        "lines": [
          "OF COURSE. THAT'S WHAT BEING",
          "A SPEED MERCHANT'S ALL ABOUT.",
          ""
        ],
        "address": "0C2FBD24"
      },
      {
        "speaker": 1,
        "lines": [
          "WELL, WITH BATTLE RACE YOU CAN",
          "SIT DOWN AT THE NEXT UNIT",
          "AND CHALLENGE THAT RACER."
        ],
        "address": "0C2FBD34"
      },
      {
        "speaker": 0,
        "lines": [
          "YEAH? PRETTY COOL!",
          "",
          ""
        ],
        "address": "0C2FBD44"
      },
      {
        "speaker": 2,
        "lines": [
          "BUT WHAT IF YOU JUST WANT TO RACE",
          "BY YOURSELF, WITH NO CHALLENGERS?",
          ""
        ],
        "address": "0C2FBD54"
      },
      {
        "speaker": 1,
        "lines": [
          "IN THAT CASE ALL YOU NEED TO DO",
          "IS SELECT REFUSE CHALLENGERS",
          "AT THE BEGINNING OF THE GAME."
        ],
        "address": "0C2FBD64"
      },
      {
        "speaker": 2,
        "lines": [
          "OH, OKAY.",
          "",
          ""
        ],
        "address": "0C2FBD74"
      },
      {
        "speaker": 1,
        "lines": [
          "NOT ONLY THAT, YOU CAN SWITCH",
          "BETWEEN REFUSE CHALLENGERS AND",
          "ACCEPT CHALLENGERS AT ANY TIME"
        ],
        "address": "0C2FBD84"
      },
      {
        "speaker": 1,
        "lines": [
          "IN THE MIDDLE OF A GAME JUST",
          "BY HITTING THE START BUTTON.",
          ""
        ],
        "address": "0C2FBD94"
      },
      {
        "speaker": 0,
        "lines": [
          "NOT BAD.",
          "",
          ""
        ],
        "address": "0C2FBDA4"
      },
      {
        "speaker": 1,
        "lines": [
          "SO, YOU GOT ALL THAT, TAK?",
          "",
          ""
        ],
        "address": "0C2FBDB4"
      },
      {
        "speaker": 2,
        "lines": [
          "SURE THING, BOSS.",
          "",
          ""
        ],
        "address": "0C2FBDC4"
      }
    ],
    [
      {
        "speaker": 0,
        "lines": [
          "HEY, COLE.",
          "",
          ""
        ],
        "address": "0C2FBDD4"
      },
      {
        "speaker": 0,
        "lines": [
          "HOW DO YOU USE",
          "NET-RANKINGS?",
          ""
        ],
        "address": "0C2FBDE4"
      },
      {
        "speaker": 2,
        "lines": [
          "WHAT'S THAT?",
          "",
          ""
        ],
        "address": "0C2FBDF4"
      },
      {
        "speaker": 1,
        "lines": [
          "WELL. FOR EXAMPLE,",
          "IF YOU GET A REALLY",
          "GOOD TIME ON TIME ATTACK,"
        ],
        "address": "0C2FBE04"
      },
      {
        "speaker": 1,
        "lines": [
          "YOU WANT TO KNOW",
          "HOW YOUR TIME STACKS",
          "UP NATIONALLY, RIGHT?"
        ],
        "address": "0C2FBE14"
      },
      {
        "speaker": 0,
        "lines": [
          "YEAH.",
          "",
          ""
        ],
        "address": "0C2FBE24"
      },
      {
        "speaker": 1,
        "lines": [
          "YOU WRITE DOWN THE PASSWORD",
          "THAT APPEARS ON THE SCREEN",
          "AFTER A TIME ATTACK RACE."
        ],
        "address": "0C2FBE34"
      },
      {
        "speaker": 1,
        "lines": [
          "THEN VISIT THE INITIAL D",
          "ARCADE STAGE VER.3",
          "OFFICIAL WEB SITE AND"
        ],
        "address": "0C2FBE44"
      },
      {
        "speaker": 1,
        "lines": [
          "KEY IN YOUR PASSWORD.",
          "",
          ""
        ],
        "address": "0C2FBE54"
      },
      {
        "speaker": 1,
        "lines": [
          "YOU'LL BE ABLE TO SEE",
          "WHERE YOU RANK NATIONALLY.",
          ""
        ],
        "address": "0C2FBE64"
      },
      {
        "speaker": 2,
        "lines": [
          "EXCELLENT!",
          "",
          ""
        ],
        "address": "0C2FBE74"
      },
      {
        "speaker": 1,
        "lines": [
          "YOU CAN ALSO SEE",
          "YOUR PASSWORD ON THE VIEW",
          "RECORDED DATA WINDOW,"
        ],
        "address": "0C2FBE84"
      },
      {
        "speaker": 1,
        "lines": [
          "SO DON'T WORRY IF YOU",
          "FORGET TO WRITE IT DOWN!",
          ""
        ],
        "address": "0C2FBE94"
      },
      {
        "speaker": 0,
        "lines": [
          "OKAY!",
          "I'M GOING TO PUT UP A REAL FAST TIME!",
          ""
        ],
        "address": "0C2FBEA4"
      }
    ]
  ],
