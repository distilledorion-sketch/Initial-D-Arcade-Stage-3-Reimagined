{
  "schema": "idas3-original-gasstand-v1",
  "source_image_sha256": "efda831f1212db54cc2e4ba53424fe390f91b2daabb07e93c1e389c3736d0335",
  "script_table": "0C2FBF58",
  "private_original_assets": true,
