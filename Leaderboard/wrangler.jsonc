{
  "name": "initial-d-reimagined-leaderboard",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "REPLAYS",
      "bucket_name": "REPLACE_WITH_YOUR_PRIVATE_REPLAY_BUCKET"
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "RULESET": "d3-community-v1",
    "RETAIN_TOP_TEN": "true",
    "DISABLE_REPLAYS": "true",
    "REQUIRED_CLIENT_BUILD": "0.3.95-community-replays.53",
    "EOS_CLIENT_ID": "REPLACE_WITH_YOUR_EOS_CLIENT_ID",
    "EOS_PRODUCT_ID": "REPLACE_WITH_YOUR_EOS_PRODUCT_ID",
    "EOS_SANDBOX_ID": "REPLACE_WITH_YOUR_EOS_SANDBOX_ID",
    "EOS_DEPLOYMENT_ID": "REPLACE_WITH_YOUR_EOS_DEPLOYMENT_ID"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "initial-d-reimagined-leaderboard",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "ONLINE_LIMIT",
      "namespace_id": "1004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "ONLINE_AUTH_LIMIT",
      "namespace_id": "1005",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
