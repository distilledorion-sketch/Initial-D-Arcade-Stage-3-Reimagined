{
  "name": "initial-d-reimagined-leaderboard",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "vars": {
    "RULESET": "d3-community-v1",
    "REQUIRED_CLIENT_BUILD": "0.3.95-community-replays.31"
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "initial-d-reimagined-leaderboard",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 4 * * *"
    ]
  }
}
