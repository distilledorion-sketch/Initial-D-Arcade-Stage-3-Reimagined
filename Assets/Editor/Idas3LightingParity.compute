// Editor-only test entry point; execute the production lighting function.
#pragma kernel CompareLighting
#include "../Resources/Idas3SceneCommon.cginc"
float4 _FixtureBase, _FixtureOffset, _FixturePosition, _FixtureNormal;
uint _FixtureBypass;
RWStructuredBuffer<float4> _FixtureResult;
[numthreads(1,1,1)]
void CompareLighting(uint3 dispatchId : SV_DispatchThreadID)
{
    float4 base = _FixtureBase, offset = _FixtureOffset;
    if (_FixtureBypass == 0)
        courseColors(base, offset, _FixturePosition.xyz, _FixtureNormal.xyz, glossCoefficient);
    _FixtureResult[0] = base;
    _FixtureResult[1] = offset;
}
